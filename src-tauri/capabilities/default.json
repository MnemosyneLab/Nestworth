{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal capability for the main Nestworth window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "log:allow-log",
    "window-state:allow-filename",
    "window-state:allow-restore-state",
    "window-state:allow-save-window-state"
  ]
}
